# Feishu app credentials (from https://open.feishu.cn/app)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 默认交互 chat（必填，锁定交互逻辑：桥接器只在这个 chat 收发）
# 群聊填 oc_xxx，私聊填 ou_xxx
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# Jira credentials (optional — leave empty if not used)
JIRA_BASE_URL=https://jira.boomingtechs.cn
JIRA_PAT=

# Claude Code settings
CLAUDE_BIN=C:\Users\xxx\.local\bin\claude.exe
CLAUDE_PERMISSION_MODE=acceptEdits

# Working directory for Claude
CLAUDE_CWD=C:\Users\xxx

# Queue settings
MAX_CONCURRENT_CLAUDE=2
SOFT_TIMEOUT_MS=300000
HARD_TIMEOUT_MS=900000

# Message chunking
MAX_CHUNK_CHARS=15000
MAX_CHUNKS=5

# Logging
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# Session pruning (days)
SESSION_PRUNE_DAYS=30